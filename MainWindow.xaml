<Window x:Class="SportFoglalasok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sportlétesítmény-foglalások" Height="800" Width="1120"
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Sportlétesítmény-foglalások" FontSize="26" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock Text="Foglalások betöltése, felvétele és áttekintése" Margin="0,5,0,0" FontSize="14" Foreground="#657089" />
        </StackPanel>

        <Border Grid.Row="1" Padding="14" Margin="0,0,0,14" Background="White" CornerRadius="8" BorderBrush="#E2E7F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Adatfájl" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="Válasszon egy TXT-fájlt a foglalások betöltéséhez és mentéséhez." Margin="0,4,0,0" FontSize="12" Foreground="#657089" />
                </StackPanel>
                <TextBlock x:Name="FilePathText" Grid.Column="1" VerticalAlignment="Center" Text="Nincs kiválasztott fájl" TextTrimming="CharacterEllipsis" Foreground="#657089" Margin="0,0,16,0" />
                <Button Grid.Column="2" Content="Fájl kiválasztása" Padding="16,9" Click="SelectFileButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="16" Margin="0,0,0,14" Background="White" CornerRadius="8" BorderBrush="#E2E7F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Új foglalás" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,12" />

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Foglaló neve" Margin="0,0,0,5" Foreground="#46516A" />
                    <TextBox x:Name="NameTextBox" Height="34" Padding="8,5" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Dátum" Margin="0,0,0,5" Foreground="#46516A" />
                    <DatePicker x:Name="BookingDatePicker" Height="34" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Helyszín" Margin="0,0,0,5" Foreground="#46516A" />
                    <ComboBox x:Name="LocationComboBox" Height="34" Padding="7,4">
                        <ComboBoxItem Content="Tornaterem - 1. fél" />
                        <ComboBoxItem Content="Tornaterem - 2. fél" />
                        <ComboBoxItem Content="Tornaterem - teljes terem" />
                        <ComboBoxItem Content="Focipálya" />
                        <ComboBoxItem Content="Asztalitenisz - 1. asztal" />
                        <ComboBoxItem Content="Asztalitenisz - 2. asztal" />
                        <ComboBoxItem Content="Asztalitenisz - 3. asztal" />
                        <ComboBoxItem Content="Teqball asztal" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <StackPanel Width="120" Margin="0,0,10,0">
                        <TextBlock Text="Kezdés (HH:mm)" Margin="0,0,0,5" Foreground="#46516A" />
                        <TextBox x:Name="StartTimeTextBox" Height="34" Padding="8,5" Text="16:00" />
                    </StackPanel>
                    <StackPanel Width="120">
                        <TextBlock Text="Befejezés" Margin="0,0,0,5" Foreground="#46516A" />
                        <TextBox x:Name="EndTimeTextBox" Height="34" Padding="8,5" Text="17:00" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Felszerelés" Margin="0,0,0,5" Foreground="#46516A" />
                    <ComboBox x:Name="EquipmentOptionComboBox" Height="34" Padding="7,4" SelectionChanged="EquipmentOptionComboBox_SelectionChanged">
                        <ComboBoxItem Content="Saját eszközzel érkezek" />
                        <ComboBoxItem Content="Eszközt kérek" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                    <TextBlock Text="Kért eszközök" Margin="0,0,0,5" Foreground="#46516A" />
                    <TextBox x:Name="EquipmentTextBox" Height="34" Padding="8,5" IsEnabled="False" ToolTip="Például: pingpongütő és labda" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="AddBookingButton" Content="Foglalás hozzáadása" Padding="16,9" Click="AddBookingButton_Click" />
                    <Button x:Name="CancelEditButton" Content="Mégse" Padding="16,9" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelEditButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="BookingsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" BorderBrush="#E2E7F0" RowBackground="White"
                  AlternatingRowBackground="#F8FAFD" Padding="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="1.3*" />
                <DataGridTextColumn Header="Dátum" Binding="{Binding Datum, StringFormat={}{0:yyyy. MM. dd.}}" Width="1.1*" />
                <DataGridTextColumn Header="Kezdés" Binding="{Binding Kezdes}" Width="0.7*" />
                <DataGridTextColumn Header="Befejezés" Binding="{Binding Befejezes}" Width="0.8*" />
                <DataGridTextColumn Header="Helyszín" Binding="{Binding Helyszin}" Width="1.4*" />
                <DataGridTextColumn Header="Eszközök" Binding="{Binding Eszkozok}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kijelölt módosítása" Padding="14,8" Margin="0,0,8,0" Click="EditSelectedButton_Click" />
            <Button Content="Kijelölt lemondása / törlése" Padding="14,8" Click="DeleteSelectedButton_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="2,10,0,0" Text="Válasszon ki egy adatfájlt a foglalások betöltéséhez." Foreground="#657089" />
    </Grid>
</Window>
